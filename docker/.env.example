# ============================================================
# docker/.env.example
# Copia este archivo como docker/.env y rellena los valores reales.
# NUNCA comitees docker/.env — ya está en .gitignore.
# ============================================================

# ── Base de datos PostgreSQL ──────────────────────────────────
# Nombre de la base de datos que crea el contenedor db
POSTGRES_DB=apexmetrics_db

# Usuario de PostgreSQL
POSTGRES_USER=apexuser

# Contraseña de PostgreSQL (cámbiala en cualquier entorno no-local)
POSTGRES_PASSWORD=apexpass

# ── Backend / JWT ─────────────────────────────────────────────
# Clave secreta para firmar tokens JWT.
# DEBE tener al menos 32 caracteres y ser aleatoria en producción.
# Ejemplo de generación: openssl rand -hex 32
JWT_SECRET=cambiar-por-secreto-de-al-menos-32-caracteres-aleatorios

# Tiempo de expiración del token JWT en milisegundos (default: 1 hora)
JWT_EXPIRATION_MS=3600000

# ── Despliegue ────────────────────────────────────────────────
# Puerto del host donde se publica el frontend (nginx).
# Local: 5173 (default). Producción/VPS: 80.
FRONTEND_PORT=5173

# ── Integraciones externas ────────────────────────────────────
# Clave de la API de Google Gemini (IA de feedback de telemetría).
# Déjala vacía para deshabilitar el feedback IA en desarrollo.
# Obtén una en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Correo (UC03: recuperación de contraseña) ─────────────────
# Servidor SMTP para enviar el enlace de reseteo. Si MAIL_HOST queda vacío,
# el backend NO envía correo y escribe el enlace en su log (modo desarrollo).
# Para demo sin cuenta real: Ethereal (https://ethereal.email) o Mailtrap.
# Para Gmail: MAIL_HOST=smtp.gmail.com + App Password de la cuenta.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Remitente que ve el usuario (opcional; default: MAIL_USERNAME)
MAIL_FROM=

# URL pública del frontend, usada para armar el enlace absoluto del correo.
# Local: http://localhost:5173 · Producción: http://<IP-o-dominio>
FRONTEND_BASE_URL=
